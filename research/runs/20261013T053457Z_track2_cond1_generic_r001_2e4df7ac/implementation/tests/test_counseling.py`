import pytest
from counseling import (
    CounselingService, 
    SlotNotFoundError, 
    SlotAlreadyBookedError, 
    BookingNotFoundError, 
    BookingVerificationError,
    CounselingError
)

@pytest.fixture
def service():
    # Use in-memory database for tests
    return CounselingService(db_path=":memory:")

def test_add_and_query_slots(service):
    service.add_available_slot("counselor-1", "2026-10-20T14:00:00+09:00")
    service.add_available_slot("counselor-1", "2026-10-20T14:30:00+09:00")
    service.add_available_slot("counselor-2", "2026-10-20T15:00:00+09:00")
    service.add_available_slot("counselor-1", "2026-10-21T10:00:00+09:00")

    # Query all available
    all_slots = service.query_available_slots()
    assert len(all_slots) == 4

    # Query by counselor
    c1_slots = service.query_available_slots(counselor_id="counselor-1")
    assert len(c1_slots) == 3

    # Query by date
    date_slots = service.query_available_slots(date="2026-10-20")
    assert len(date_slots) == 3

    # Query by both
    c1_date_slots = service.query_available_slots(counselor_id="counselor-1", date="2026-10-20")
    assert len(c1_date_slots) == 2

def test_create_booking_success(service):
    start_time = "2026-10-20T14:00:00+09:00"
    service.add_available_slot("counselor-1", start_time)
    
    booking_id = service.create_booking(
        "counselor-1", start_time, "John Doe", "john@example.com"
    )
    
    assert booking_id is not None
    # Verify slot is no longer available
    slots = service.query_available_slots(counselor_id="counselor-1")
    assert len(slots) == 0

def test_create_booking_duplicate_rejection(service):
    start_time = "2026-10-20T14:00:00+09:00"
    service.add_available_slot("counselor-1", start_time)
    
    service.create_booking("counselor-1", start_time, "John Doe", "john@example.com")
    
    with pytest.raises(SlotAlreadyBookedError):
        service.create_booking("counselor-1", start_time, "Jane Doe", "jane@example.com")

def test_create_booking_nonexistent_slot(service):
    with pytest.raises(SlotNotFoundError):
        service.create_booking("counselor-1", "2026-10-20T14:00:00+09:00", "John Doe", "john@example.com")

def test_lookup_booking_success(service):
    start_time = "2026-10-20T14:00:00+09:00"
    service.add_available_slot("counselor-1", start_time)
    booking_id = service.create_booking("counselor-1", start_time, "John Doe", "john@example.com")
    
    booking = service.lookup_booking(booking_id, "john@example.com")
    assert booking['client_name'] == "John Doe"
    assert booking['status'] == "CONFIRMED"
    assert booking['counselor_id'] == "counselor-1"

def test_lookup_booking_wrong_email(service):
    start_time = "2026-10-20T14:00:00+09:00"
    service.add_available_slot("counselor-1", start_time)
    booking_id = service.create_booking("counselor-1", start_time, "John Doe", "john@example.com")
    
    with pytest.raises(BookingVerificationError):
        service.lookup_booking(booking_id, "wrong@example.com")

def test_lookup_booking_not_found(service):
    with pytest.raises(BookingNotFoundError):
        service.lookup_booking("non-existent-id", "any@example.com")

def test_cancel_booking_success(service):
    start_time = "2026-10-20T14:00:00+09:00"
    service.add_available_slot("counselor-1", start_time)
    booking_id = service.create_booking("counselor-1", start_time, "John Doe", "john@example.com")
    
    service.cancel_booking(booking_id, "john@example.com")
    
    # Verify booking status
    booking = service.lookup_booking(booking_id, "john@example.com")
    assert booking['status'] == "CANCELLED"
    
    # Verify slot is available again
    slots = service.query_available_slots(counselor_id="counselor-1")
    assert len(slots) == 1
    assert slots[0]['start_time'] == start_time

def test_cancel_booking_wrong_email(service):
    start_time = "2026-10-20T14:00:00+09:00"
    service.add_available_slot("counselor-1", start_time)
    booking_id = service.create_booking("counselor-1", start_time, "John Doe", "john@example.com")
    
    with pytest.raises(BookingVerificationError):
        service.cancel_booking(booking_id, "wrong@example.com")

def test_cancel_already_cancelled_booking(service):
    start_time = "2026-10-20T14:00:00+09:00"
    service.add_available_slot("counselor-1", start_time)
    booking_id = service.create_booking("counselor-1", start_time, "John Doe", "john@example.com")
    
    service.cancel_booking(booking_id, "john@example.com")
    
    with pytest.raises(CounselingError):
        service.cancel_booking(booking_id, "john@example.com")

def test_invalid_iso_format(service):
    with pytest.raises(ValueError):
        service.add_available_slot("counselor-1", "not-a-date")
